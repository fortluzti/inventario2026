# ==========================================================
# ativos2026/apiphp — Configuracao local (NAO versionar!)
# Copie para .env e ajuste.
# ==========================================================

# --- Ambiente ---
APP_ENV=production            # development | production
APP_DEBUG=true               # true SOMENTE em dev (expoe detalhes de erro)
APP_TIMEZONE=America/Sao_Paulo

# --- Banco de dados (inventario2 — backup restaurado) ---
DB_HOST=192.168.0.57
DB_PORT=3306
DB_NAME=inventario2
DB_USER=root
DB_PASS='@mysql1'
DB_CHARSET=utf8mb4

# --- API Keys ---
# Senha-mestre usada para gerar/verificar HMAC das chaves.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
API_SIGNING_SECRET=troque_por_32_bytes_aleatorios

# --- CORS (allowlist) ---
# Origens autorizadas, separadas por virgula. Vazio = sem CORS (mesma origem).
CORS_ORIGINS=https://intranet.fortluz.com.br,http://localhost:5173

# --- Rate limit (por chave, por minuto) ---
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=10

# --- Auditoria ---
AUDIT_LOG=true
AUDIT_LOG_PATH=../storage/logs/audit-%Y-%m-%d.log
